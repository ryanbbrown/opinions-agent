    23	def reconcile_startup(session: Session, settings: Settings) -> list[OpinionRun]:
    24	    """Reconcile durable commit phases and stop unsafe interrupted model calls."""
    25	    now = datetime.now(UTC)
    26	    stopped: list[OpinionRun] = []
    27	    running = list(session.scalars(select(OpinionRun).where(OpinionRun.status == RunStatus.RUNNING_AGENT.value)))
    28	    for run in running:
    29	        if reconcile_git_durability(settings, run):
    30	            complete_reconciled_run(session, settings, run)
    31	            continue
    32	        if run.lease_expires_at is None or _utc(run.lease_expires_at) > now:
    33	            continue
    34	        archive_and_restore_run(settings, run, _run_dir(run, settings))
    35	        run.status = RunStatus.FAILED.value
    36	        run.failure_reason = "interrupted_agent"
    37	        if run.cycle_id:
    38	            cycle = session.get(OpinionCycle, run.cycle_id)
    39	            if cycle is not None:
    40	                cycle.status = CycleStatus.STOPPED.value
    41	                cycle.failure_code = "interrupted_agent"
    42	                cycle.failure_summary = "The model call was interrupted. Retry the stored batch."
    43	            batch = _batch_for_run(session, run)
    44	            if batch is not None:
    45	                batch.status = BatchStatus.STOPPED.value
    46	        stopped.append(run)
    47	    session.commit()
    48	    return stopped
    49	
    50	
    51	async def process_queued_once(
    52	    session: Session,
    53	    settings: Settings,
    54	    agent: OpinionAgent,
    55	    telegram: TelegramSender,
    56	) -> bool:
    57	    pending_run = session.scalar(
    58	        select(OpinionRun).where(OpinionRun.status == RunStatus.PENDING_AGENT.value).order_by(OpinionRun.created_at)
    59	    )
    60	    if pending_run is not None:
    61	        await run_pending_opinion_run(
    62	            session=session,
    63	            settings=settings,
    64	            agent=agent,
    65	            telegram=telegram,
    66	            run=pending_run,
    67	        )
    68	        return True
    69	    active = session.scalar(
    70	        select(OpinionRun).where(
    71	            OpinionRun.status.in_(
    72	                [RunStatus.RUNNING_AGENT.value, RunStatus.AWAITING_USER.value, RunStatus.PENDING_AGENT.value]
    73	            )
    74	        )
    75	    )
    76	    if active is not None:
    77	        return False
    78	    batch = session.scalar(
    79	        select(OpinionBatch)
    80	        .join(OpinionCycle, OpinionCycle.id == OpinionBatch.cycle_id)
    81	        .where(
    82	            OpinionBatch.status == BatchStatus.QUEUED.value,
    83	            OpinionCycle.status == CycleStatus.ACTIVE.value,
    84	            OpinionBatch.batch_number == OpinionCycle.current_batch,
    85	        )
    86	        .order_by(OpinionCycle.created_at, OpinionBatch.batch_number)
    87	    )
    88	    if batch is None:
    89	        return False
    90	    await start_materialized_opinion_run(
    91	        session=session,
    92	        settings=settings,
    93	        agent=agent,
    94	        telegram=telegram,
    95	        batch=batch,
    96	    )
    97	    return True
    98	
    99	
   100	async def worker_loop(
   101	    SessionLocal: sessionmaker[Session],
   102	    settings: Settings,
   103	    agent: OpinionAgent,
   104	    telegram: TelegramSender,
   105	    stop: asyncio.Event,
   106	) -> None:
   107	    while not stop.is_set():
   108	        with SessionLocal() as session:
   109	            try:
   110	                worked = await process_queued_once(session, settings, agent, telegram)
   111	            except Exception:
   112	                session.rollback()
   113	                worked = False
   114	        if not worked:
   115	            try:
   116	                await asyncio.wait_for(stop.wait(), timeout=2)
   117	            except TimeoutError:
   118	                pass
   119	
   120	
   121	def _batch_for_run(session: Session, run: OpinionRun) -> OpinionBatch | None:
   122	    if not run.cycle_id:
   123	        return None
   124	    return session.scalar(
   125	        select(OpinionBatch).where(
   126	            OpinionBatch.cycle_id == run.cycle_id,
   127	            OpinionBatch.batch_number == run.batch,
   128	        )
   129	    )
   130	
   131	
   132	def _run_dir(run: OpinionRun, settings: Settings):
   133	    from pathlib import Path
   134	
   135	    return Path((run.input_paths or {}).get("dir") or settings.runs_dir / "active" / run.id)
   136	
   137	
   138	def _utc(value: datetime) -> datetime:
   139	    return value if value.tzinfo is not None else value.replace(tzinfo=UTC)

