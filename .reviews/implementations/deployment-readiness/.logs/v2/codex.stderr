    11	def load_dotenv(path: Path | str = ".env") -> None:
    12	    env_path = Path(path)
    13	    if not env_path.exists():
    14	        return
    15	    for line in env_path.read_text().splitlines():
    16	        stripped = line.strip()
    17	        if not stripped or stripped.startswith("#") or "=" not in stripped:
    18	            continue
    19	        key, value = stripped.split("=", 1)
    20	        key = key.strip()
    21	        value = value.strip().strip('"').strip("'")
    22	        os.environ.setdefault(key, value)
