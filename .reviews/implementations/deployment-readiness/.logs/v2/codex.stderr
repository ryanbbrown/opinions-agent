   404	def _completion_summary(settings: Settings) -> str:
   405	    baseline_doc = parse_opinions(run_git(settings.opinions_repo_dir, "show", f"HEAD:{settings.opinions_target_file}"))
   406	    current_doc = load_opinions(settings.opinions_target_path)
   407	    baseline_by_id = {opinion.opinion_id: opinion for opinion in baseline_doc.opinions}
   408	    current_by_id = {opinion.opinion_id: opinion for opinion in current_doc.opinions}
   409	
   410	    added = len(set(current_by_id) - set(baseline_by_id))
   411	    removed = len(set(baseline_by_id) - set(current_by_id))
   412	    updated = sum(
   413	        1
   414	        for opinion_id in set(current_by_id) & set(baseline_by_id)
   415	        if current_by_id[opinion_id] != baseline_by_id[opinion_id]
   416	    )
   417	    evidence_changed = _source_row_change_count(
   418	        _source_rows_from_git(settings),
   419	        read_sources(settings.opinions_sources_path),
   420	    )
   421	    return (
   422	        f"Done: {added} opinions added, {updated} opinions updated, {removed} opinions removed, "
   423	        f"and {evidence_changed} evidence rows changed."
   424	    )
   425	
   426	
   427	def _source_rows_from_git(settings: Settings) -> list[dict[str, Any]]:
   428	    text = run_git(settings.opinions_repo_dir, "show", f"HEAD:{settings.opinions_sources_file}")
   429	    return [json.loads(line) for line in text.splitlines() if line.strip()]
   430	
   431	
   432	def _source_row_change_count(baseline_rows: list[dict[str, Any]], current_rows: list[dict[str, Any]]) -> int:
   433	    baseline_by_key = {_source_row_key(row): row for row in baseline_rows}
   434	    current_by_key = {_source_row_key(row): row for row in current_rows}
   435	    added = set(current_by_key) - set(baseline_by_key)
   436	    removed = set(baseline_by_key) - set(current_by_key)
   437	    updated = {
   438	        key
   439	        for key in set(current_by_key) & set(baseline_by_key)
   440	        if _canonical_source_row(current_by_key[key]) != _canonical_source_row(baseline_by_key[key])
   441	    }
   442	    return len(added) + len(removed) + len(updated)
   443	
   444	
   445	def _source_row_key(row: dict[str, Any]) -> tuple[str, str]:
   446	    return (str(row.get("opinion_id")), str(row.get("evidence_id")))
   447	
   448	
   449	def _canonical_source_row(row: dict[str, Any]) -> str:
   450	    return json.dumps(row, sort_keys=True, separators=(",", ":"))
