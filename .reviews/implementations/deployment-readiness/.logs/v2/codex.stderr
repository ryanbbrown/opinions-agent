   188	def build_system_prompt(*, rules_path: Path | None = None) -> str:
   189	    rules = load_opinion_rules(rules_path)
   190	    return "\n\n".join(
   191	        [
   192	            OPINION_AGENT_ROLE_INSTRUCTIONS.strip(),
   193	            EVIDENCE_AND_WORKFLOW_INSTRUCTIONS.strip(),
   194	            TELEGRAM_MESSAGE_INSTRUCTIONS.strip(),
   195	            "Opinion selection rules from RULES.md:\n\n" + rules.rstrip(),
   196	            TOOL_INSTRUCTIONS.strip(),
   197	            ARTIFACT_BOUNDARY_INSTRUCTIONS.strip(),
   198	        ]
   199	    )
