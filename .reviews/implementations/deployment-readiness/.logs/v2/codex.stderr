   117	def _document_groups(rows: list[HighlightRow]) -> list[list[HighlightRow]]:
   118	    by_document: dict[str, list[HighlightRow]] = {}
   119	    order: list[str] = []
   120	    for row in rows:
   121	        if row.document_id not in by_document:
   122	            by_document[row.document_id] = []
   123	            order.append(row.document_id)
   124	        by_document[row.document_id].append(row)
   125	    return [by_document[document_id] for document_id in order]
