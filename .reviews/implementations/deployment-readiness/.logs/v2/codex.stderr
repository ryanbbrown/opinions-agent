    20	def capture_run_baseline(settings: Settings, run: OpinionRun, run_dir: Path) -> Path:
    21	    """Record the exact writable files and repository base for one run."""
    22	    target_files = [settings.opinions_target_file, settings.opinions_sources_file]
    23	    assert_targets_clean(settings.opinions_repo_dir, target_files)
    24	    run.git_base_sha = run_git(settings.opinions_repo_dir, "rev-parse", "HEAD")
    25	    run.git_phase = GitPhase.AGENT_EDITING.value
    26	    recovery = run_dir / "recovery" / run.id
    27	    baseline = recovery / "baseline"
    28	    baseline.mkdir(parents=True, exist_ok=True)
    29	    _copy_if_present(settings.opinions_target_path, baseline / "opinions.md")
    30	    _copy_if_present(settings.opinions_sources_path, baseline / "sources.jsonl")
    31	    corpus = CorpusPaths(settings.opinions_data_dir)
    32	    _copy_if_present(corpus.decisions_jsonl, baseline / "decisions.jsonl")
    33	    _copy_if_present(corpus.opinion_id_high_water, baseline / "opinion-id-high-water.json")
    34	    run.decision_log_hash = file_hash(corpus.decisions_jsonl)
    35	    return recovery
    36	
    37	
    38	def archive_and_restore_run(settings: Settings, run: OpinionRun, run_dir: Path) -> Path:
    39	    """Archive failed edits and restore only the configured writable artifacts."""
    40	    recovery = run_dir / "recovery" / run.id
    41	    failed = recovery / "failed"
    42	    failed.mkdir(parents=True, exist_ok=True)
    43	    diff = run_git(
    44	        settings.opinions_repo_dir,
    45	        "diff",
    46	        "--",
    47	        settings.opinions_target_file,
    48	        settings.opinions_sources_file,
    49	    )
    50	    write_text_atomic(failed / "changes.patch", diff + ("\n" if diff else ""))
    51	    _copy_if_present(settings.opinions_target_path, failed / "opinions.md")
    52	    _copy_if_present(settings.opinions_sources_path, failed / "sources.jsonl")
    53	    corpus = CorpusPaths(settings.opinions_data_dir)
    54	    _copy_if_present(corpus.decisions_jsonl, failed / "decisions.jsonl")
    55	    _restore(recovery / "baseline" / "opinions.md", settings.opinions_target_path)
    56	    _restore(recovery / "baseline" / "sources.jsonl", settings.opinions_sources_path)
    57	    _restore(recovery / "baseline" / "decisions.jsonl", corpus.decisions_jsonl)
    58	    _restore(recovery / "baseline" / "opinion-id-high-water.json", corpus.opinion_id_high_water)
    59	    return failed
    60	
    61	
    62	def remote_contains_result(settings: Settings, run: OpinionRun) -> bool:
    63	    if not run.git_result_sha:
    64	        return False
    65	    output = run_git(
    66	        settings.opinions_repo_dir,
    67	        "ls-remote",
    68	        "origin",
    69	        f"refs/heads/{settings.opinions_repo_branch}",
    70	        env=git_credential_env(settings.opinions_git_token),
    71	    )
    72	    return bool(output and output.split()[0] == run.git_result_sha)
    73	
    74	
    75	def reconcile_git_durability(settings: Settings, run: OpinionRun) -> bool:
    76	    """Finish a known commit or push without running the agent again."""
    77	    if run.git_phase == GitPhase.COMMIT_INTENT.value and not run.git_result_sha:
    78	        latest = run_git(settings.opinions_repo_dir, "log", "-1", "--format=%H%x00%s")
    79	        sha, _, message = latest.partition("\x00")
    80	        if message == f"chore: complete opinion run {run.id}":
    81	            run.git_result_sha = sha
    82	            run.git_phase = GitPhase.COMMITTED.value
    83	    if not run.git_result_sha:
    84	        return False
    85	    if remote_contains_result(settings, run):
    86	        run.git_phase = GitPhase.PUSHED.value
    87	        return True
    88	    if run.git_phase != GitPhase.COMMITTED.value:
    89	        return False
    90	    head = run_git(settings.opinions_repo_dir, "rev-parse", "HEAD")
    91	    if head != run.git_result_sha:
    92	        return False
    93	    run_git(
    94	        settings.opinions_repo_dir,
    95	        "push",
    96	        "origin",
    97	        f"{run.git_result_sha}:refs/heads/{settings.opinions_repo_branch}",
    98	        env=git_credential_env(settings.opinions_git_token),
    99	    )
   100	    run.git_phase = GitPhase.PUSHED.value
   101	    return remote_contains_result(settings, run)
   102	
   103	
   104	def _copy_if_present(source: Path, target: Path) -> None:
   105	    if source.exists():
   106	        target.parent.mkdir(parents=True, exist_ok=True)
   107	        shutil.copy2(source, target)
   108	
   109	
   110	def _restore(source: Path, target: Path) -> None:
