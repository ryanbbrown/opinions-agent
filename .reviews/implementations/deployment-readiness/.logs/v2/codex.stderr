   264	
   265	async def _run_agent_turn(
   266	    *,
   267	    session: Session,
   268	    settings: Settings,
   269	    agent: OpinionAgent,
   270	    telegram: TelegramSender,
   271	    run: OpinionRun,
   272	    prompt_fragment: str | None,
   273	) -> None:
   274	    if run.status == RunStatus.PENDING_AGENT.value:
   275	        transition(run, RunStatus.RUNNING_AGENT)
   276	        run.lease_owner = uuid4().hex
   277	        run.lease_expires_at = utcnow() + timedelta(minutes=15)
   278	        session.commit()
   279	    context = build_read_context(settings, _run_dir(run, settings))
   280	    output, resume_state = await agent.run_turn(
   281	        run_id=run.id,
   282	        context=context,
   283	        settings=settings,
   284	        prompt_fragment=prompt_fragment,
   285	        resume_state=run.resume_state,
   286	    )
   287	    run.agent_output = output.model_dump(mode="json")
   288	    run.resume_state = resume_state
   289	    run.turn_seq += 1
   290	    run.attempts += 1
   291	    if prompt_fragment is None and run.turn_seq == 1:
   292	        _write_initial_telegram_review(_run_dir(run, settings), output)
   293	    if output.status == "awaiting_user":
   294	        transition(run, RunStatus.AWAITING_USER)
   295	        run.lease_owner = None
   296	        run.lease_expires_at = None
   297	        _set_batch_status(session, run, BatchStatus.AWAITING_USER)
   298	        session.commit()
   299	        await send_agent_messages(session=session, settings=settings, telegram=telegram, run=run, output=output)
   300	        return
   301	    if output.status == "blocked":
   302	        transition(run, RunStatus.BLOCKED)
   303	        run.lease_owner = None
   304	        run.lease_expires_at = None
   305	        run.failure_reason = output.notes or "agent returned blocked"
   306	        _stop_cycle(session, run, "agent_blocked", "The opinion agent needs manual intervention.")
   307	        session.commit()
   308	        await send_agent_messages(session=session, settings=settings, telegram=telegram, run=run, output=output)
   309	        return
   310	    if output.status == "done":
   311	        session.commit()
   312	        await _complete_done_run(session=session, settings=settings, telegram=telegram, run=run, output=output)
   313	        return
   314	    raise ValueError(f"unsupported agent status: {output.status}")
   315	
   316	
   317	async def _complete_done_run(
   318	    *,
   319	    session: Session,
   320	    settings: Settings,
   321	    telegram: TelegramSender,
   322	    run: OpinionRun,
   323	    output: AgentTurnOutput,
   324	) -> None:
   325	    commit_boundary_finished = False
   326	    try:
   327	        validation = run_artifact_validation(settings=settings, run_dir=_run_dir(run, settings))
   328	        fallback_summary = _completion_summary(settings)
   329	        run.git_phase = GitPhase.COMMIT_INTENT.value
   330	        session.commit()
   331	        commit = commit_and_push_opinions_files(
   332	            repo_dir=settings.opinions_repo_dir,
   333	            target_files=[settings.opinions_target_file, settings.opinions_sources_file],
   334	            branch=settings.opinions_repo_branch,
   335	            author_name=settings.opinions_git_author_name,
   336	            author_email=settings.opinions_git_author_email,
   337	            message=f"chore: complete opinion run {run.id}",
   338	            push=False,
   339	            git_token=settings.opinions_git_token,
   340	        )
   341	        run.git_result_sha = commit.commit_sha
   342	        run.git_phase = GitPhase.COMMITTED.value
   343	        session.commit()
   344	        if commit.commit_sha:
   345	            run_git(
   346	                settings.opinions_repo_dir,
   347	                "push",
   348	                "origin",
   349	                settings.opinions_repo_branch,
   350	                env=git_credential_env(settings.opinions_git_token),
   351	            )
   352	        run.git_phase = GitPhase.PUSHED.value
   353	        session.commit()
   354	        commit_boundary_finished = True
   355	        update_opinion_id_high_water(settings, validation.high_water_mark)
   356	        run.decision_log_hash = file_hash(CorpusPaths(settings.opinions_data_dir).decisions_jsonl)
   357	        if run.cycle_id:
   358	            _complete_cycle_batch(session, settings, run, commit.commit_sha, validation.summary)
   359	        else:
   360	            _finalize_run_artifacts(
   361	                settings,
   362	                run,
   363	                status=RunStatus.COMPLETED.value,
   364	                commit_sha=commit.commit_sha,
   365	                validation_summary=validation.summary,
   366	            )
   367	        transition(run, RunStatus.COMPLETED)
   368	        run.lease_owner = None
   369	        run.lease_expires_at = None
   370	        run.git_phase = GitPhase.COMPLETED.value
   371	        session.commit()
   372	        durability = f"commit {commit.commit_sha}" if commit.commit_sha else "no opinion file changes"
   373	        final_messages = output.telegram_messages or [TelegramMessageSpec(text=fallback_summary)]
   374	        final_output = AgentTurnOutput(
   375	            status="done",
   376	            telegram_messages=[
   377	                message.model_copy(update={"text": f"{message.text}\n\nDurability: {durability}"})
   378	                for message in final_messages
   379	            ],
   380	            notes=output.notes,
   381	        )
   382	        run.agent_output = final_output.model_dump(mode="json")
   383	        session.commit()
   384	        await send_agent_messages(session=session, settings=settings, telegram=telegram, run=run, output=final_output)
   385	    except Exception as exc:
   386	        _fail_run(session, run, str(exc))
   387	        if run.cycle_id:
   388	            await send_cycle_failure_notice(session=session, settings=settings, telegram=telegram, run=run)
   389	        else:
   390	            phase = "after commit handling" if commit_boundary_finished else "before commit"
   391	            await send_agent_messages(
   392	                session=session,
   393	                settings=settings,
   394	                telegram=telegram,
   395	                run=run,
   396	                output=AgentTurnOutput(
   397	                    status="blocked",
   398	                    telegram_messages=[TelegramMessageSpec(text=f"Opinion run failed {phase}.")],
   399	                ),
   400	            )
   401	        raise
   402	
   403	
   404	def _completion_summary(settings: Settings) -> str:
   405	    baseline_doc = parse_opinions(run_git(settings.opinions_repo_dir, "show", f"HEAD:{settings.opinions_target_file}"))
   406	    current_doc = load_opinions(settings.opinions_target_path)
   407	    baseline_by_id = {opinion.opinion_id: opinion for opinion in baseline_doc.opinions}
   408	    current_by_id = {opinion.opinion_id: opinion for opinion in current_doc.opinions}
   409	
   410	    added = len(set(current_by_id) - set(baseline_by_id))
   411	    removed = len(set(baseline_by_id) - set(current_by_id))
   412	    updated = sum(
   413	        1
   414	        for opinion_id in set(current_by_id) & set(baseline_by_id)
   415	        if current_by_id[opinion_id] != baseline_by_id[opinion_id]
   416	    )
   417	    evidence_changed = _source_row_change_count(
   418	        _source_rows_from_git(settings),
   419	        read_sources(settings.opinions_sources_path),
   420	    )
   421	    return (
   422	        f"Done: {added} opinions added, {updated} opinions updated, {removed} opinions removed, "
   423	        f"and {evidence_changed} evidence rows changed."
   424	    )
   425	
   426	
   427	def _source_rows_from_git(settings: Settings) -> list[dict[str, Any]]:
   428	    text = run_git(settings.opinions_repo_dir, "show", f"HEAD:{settings.opinions_sources_file}")
   429	    return [json.loads(line) for line in text.splitlines() if line.strip()]
   430	
   431	
   432	def _source_row_change_count(baseline_rows: list[dict[str, Any]], current_rows: list[dict[str, Any]]) -> int:
   433	    baseline_by_key = {_source_row_key(row): row for row in baseline_rows}
   434	    current_by_key = {_source_row_key(row): row for row in current_rows}
   435	    added = set(current_by_key) - set(baseline_by_key)
   436	    removed = set(baseline_by_key) - set(current_by_key)
   437	    updated = {
   438	        key
   439	        for key in set(current_by_key) & set(baseline_by_key)
   440	        if _canonical_source_row(current_by_key[key]) != _canonical_source_row(baseline_by_key[key])
   441	    }
   442	    return len(added) + len(removed) + len(updated)
   443	
   444	
   445	def _source_row_key(row: dict[str, Any]) -> tuple[str, str]:
   446	    return (str(row.get("opinion_id")), str(row.get("evidence_id")))
   447	
   448	
   449	def _canonical_source_row(row: dict[str, Any]) -> str:
   450	    return json.dumps(row, sort_keys=True, separators=(",", ":"))
   451	
   452	
   453	async def send_agent_messages(
   454	    *,
   455	    session: Session,
   456	    settings: Settings,
   457	    telegram: TelegramSender,
   458	    run: OpinionRun,
   459	    output: AgentTurnOutput | None = None,
   460	) -> None:
   461	    if output is None:
   462	        output = AgentTurnOutput.model_validate(run.agent_output)
   463	    for index, spec in enumerate(output.telegram_messages):
   464	        await _send_idempotent(
   465	            session=session,
   466	            settings=settings,
   467	            telegram=telegram,
   468	            key=f"opinion-run:{run.id}:turn:{run.turn_seq}:message:{index}",
   469	            run_id=run.id,
   470	            spec=spec,
   471	        )
   472	
   473	
   474	async def send_cycle_failure_notice(
   475	    *,
   476	    session: Session,
   477	    settings: Settings,
   478	    telegram: TelegramSender,
   479	    run: OpinionRun,
   480	) -> None:
   481	    if not run.cycle_id:
   482	        return
   483	    cycle = session.get(OpinionCycle, run.cycle_id)
   484	    code = cycle.failure_code if cycle and cycle.failure_code else "run_failed"
   485	    await _send_idempotent(
   486	        session=session,
   487	        settings=settings,
   488	        telegram=telegram,
   489	        key=f"opinion-cycle:{run.cycle_id}:batch:{run.batch}:stopped:{code}",
   490	        run_id=run.id,
   491	        spec=TelegramMessageSpec(
   492	            text=(
   493	                f"Opinion cycle {run.cycle_id} stopped at batch {run.batch}. "
   494	                f"Failure code: {code}. Retry with: opinions-agent retry-cycle {run.cycle_id}"
   495	            )
   496	        ),
   497	    )
