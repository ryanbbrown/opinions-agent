   186	        .values(owner_token=owner_token, expires_at=now + duration, updated_at=now)
   187	    )
   188	    if int(getattr(result, "rowcount", 0)) == 1:
   189	        session.commit()
   190	        return True
   191	    session.add(WorkflowLease(name=name, owner_token=owner_token, expires_at=now + duration))
   192	    try:
   193	        session.commit()
   194	    except IntegrityError:
   195	        session.rollback()
   196	        return False
   197	    return True
