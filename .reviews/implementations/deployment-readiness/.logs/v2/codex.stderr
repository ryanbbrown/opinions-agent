    31	    global startup_ready
    32	    if settings.volume_mount_path is not None:
    33	        validate_web_settings(settings)
    34	    init_data_dirs(CorpusPaths(settings.opinions_data_dir))
    35	    RunPaths(settings.runs_dir).active_dir.mkdir(parents=True, exist_ok=True)
    36	    telegram = TelegramClient(settings.telegram_bot_token)
    37	    with SessionLocal() as session:
    38	        stopped_runs = reconcile_startup(session, settings)
    39	        for run in stopped_runs:
    40	            await send_cycle_failure_notice(session=session, settings=settings, telegram=telegram, run=run)
    41	    startup_ready = True
    42	    stop = asyncio.Event()
    43	    task = asyncio.create_task(
    44	        worker_loop(
    45	            SessionLocal,
    46	            settings,
    47	            ThinHarnessOpinionAgent(),
    48	            telegram,
    49	            stop,
    50	        )
    51	    )
    52	    try:
    53	        yield
    54	    finally:
    55	        startup_ready = False
    56	        stop.set()
    57	        await task
