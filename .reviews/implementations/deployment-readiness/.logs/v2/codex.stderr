   109	) -> OpinionRun | None:
   110	    active = find_active_run(session)
   111	    if active is not None:
   112	        raise ActiveRunError(f"run {active.id} is still {active.status}; not starting another run")
   113	
   114	    ensure_opinions_repo(settings)
   115	    ensure_repo_file(settings, settings.opinions_target_file)
   116	    ensure_repo_file(settings, settings.opinions_sources_file)
   117	    assert_targets_clean(settings.opinions_repo_dir, [settings.opinions_target_file, settings.opinions_sources_file])
