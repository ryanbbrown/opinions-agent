   393	async def _set_webhook(settings, url: str) -> None:
   394	    import httpx
   395	
   396	    async with httpx.AsyncClient(timeout=20) as client:
   397	        response = await client.post(
   398	            f"https://api.telegram.org/bot{settings.telegram_bot_token}/setWebhook",
   399	            json={"url": url, "secret_token": settings.telegram_webhook_secret},
   400	        )
   401	        response.raise_for_status()
   402	        print(response.json())

