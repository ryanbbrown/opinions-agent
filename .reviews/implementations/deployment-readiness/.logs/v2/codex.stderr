   914	def _run_dir(run: OpinionRun, settings: Settings) -> Path:
   915	    configured = (run.input_paths or {}).get("dir")
   916	    if configured:
   917	        path = Path(configured)
   918	        if path.exists() or not run.cycle_id:
   919	            return path
   920	    if run.cycle_id:
   921	        return settings.runs_dir / "completed" / run.cycle_id / "batches" / str(run.batch)
   922	    return RunPaths(settings.runs_dir).active_run_dir(run.id)
