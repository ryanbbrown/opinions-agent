    41	@dataclass(frozen=True)
    42	class RunBundle:
    43	    run_dir: Path
    44	    review_summary_md: Path
    45	    selected_highlights_jsonl: Path
    46	    selected_documents_jsonl: Path
    47	    highlights: list[HighlightRow]
    48	    documents: list[DocumentRow]
    49	
    50	
    51	def select_window(highlights: list[HighlightRow], window_start: datetime, window_end: datetime) -> list[HighlightRow]:
    52	    """Select highlights with window_start <= highlighted_at < window_end, oldest first."""
    53	    selected: list[tuple[datetime, HighlightRow]] = []
    54	    for highlight in highlights:
    55	        highlighted_at = parse_iso(highlight.highlighted_at)
    56	        if highlighted_at is None:
    57	            continue
    58	        if window_start <= highlighted_at < window_end:
    59	            selected.append((highlighted_at, highlight))
    60	    selected.sort(key=lambda item: (item[0], item[1].highlight_id))
    61	    return [highlight for _, highlight in selected]
    62	
    63	
    64	def select_run_highlights(
    65	    paths: CorpusPaths,
    66	    window_start: datetime,
    67	    window_end: datetime,
    68	) -> tuple[list[HighlightRow], list[DocumentRow]]:
    69	    documents_by_id = document_by_id(paths)
    70	    all_highlights = read_highlights(paths)
    71	    highlights = [
    72	        highlight
    73	        for highlight in select_window(all_highlights, window_start, window_end)
    74	        if not _is_backfill_document(documents_by_id.get(highlight.document_id))
    75	    ]
    76	    documents_with_evidence = {highlight.document_id for highlight in all_highlights}
    77	    highlights.extend(
    78	        _select_document_summary_evidence(
    79	            paths=paths,
    80	            window_start=window_start,
    81	            window_end=window_end,
    82	            documents_with_evidence=documents_with_evidence,
    83	        )
    84	    )
    85	    highlights.sort(
    86	        key=lambda highlight: (
    87	            _evidence_datetime(highlight) or datetime.min.replace(tzinfo=UTC),
    88	            highlight.highlight_id,
    89	        )
    90	    )
    91	    seen: dict[str, DocumentRow] = {}
    92	    for highlight in highlights:
    93	        document = documents_by_id.get(highlight.document_id)
    94	        if document is not None:
    95	            seen.setdefault(document.document_id, document)
    96	    return highlights, list(seen.values())
    97	
    98	
    99	def _is_backfill_document(document: DocumentRow | None) -> bool:
   100	    return document is not None and any(tag in {"backfill", ".backfill"} for tag in document.tags)
   101	
   102	
   103	def _select_document_summary_evidence(
   104	    *,
   105	    paths: CorpusPaths,
   106	    window_start: datetime,
   107	    window_end: datetime,
   108	    documents_with_evidence: set[str],
   109	) -> list[HighlightRow]:
   110	    selected: list[tuple[datetime, HighlightRow]] = []
   111	    for document in read_documents(paths):
   112	        if document.document_id in documents_with_evidence:
   113	            continue
   114	        if _is_backfill_document(document):
   115	            continue
   116	        if not document.tags:
   117	            continue
   118	        summary = (document.summary or "").strip()
   119	        if not summary:
   120	            continue
   121	        saved_at = parse_iso(document.saved_at)
   122	        if saved_at is None or not (window_start <= saved_at < window_end):
   123	            continue
   124	        selected.append((saved_at, _document_summary_evidence(document, summary, saved_at)))
   125	    selected.sort(key=lambda item: (item[0], item[1].highlight_id))
   126	    return [row for _, row in selected]
   127	
   128	
   129	def _document_summary_evidence(document: DocumentRow, summary: str, saved_at: datetime) -> HighlightRow:
   130	    return HighlightRow(
   131	        highlight_id=reader_summary_key(document.reader_id),
   132	        evidence_kind="document_summary",
   133	        document_id=document.document_id,
   134	        reader_id=document.reader_id,
   135	        document_title=document.title,
   136	        document_author=document.author,
   137	        document_summary=document.summary,
   138	        source_url=document.source_url,
   139	        text=summary,
   140	        highlighted_at=iso_utc(saved_at),
   141	        highlighted_date=saved_at.astimezone(UTC).date().isoformat(),
   142	        highlighted_week=iso_week(saved_at),
   143	        updated_at=document.updated_at,
   144	        content_path=document.content_path,
   145	    )
   146	
   147	
   148	def _evidence_datetime(evidence: HighlightRow) -> datetime | None:
   149	    return parse_iso(evidence.highlighted_at)
   150	
   151	
   152	def write_run_bundle(
   153	    *,
   154	    run_id: str,
   155	    run_paths: RunPaths,
   156	    window_start: datetime,
   157	    window_end: datetime,
   158	    highlights: list[HighlightRow],
   159	    documents: list[DocumentRow],
   160	) -> RunBundle:
   161	    run_dir = run_paths.active_run_dir(run_id)
   162	    run_dir.mkdir(parents=True, exist_ok=True)
   163	    review_dir = run_dir / "review"
   164	    review_dir.mkdir(parents=True, exist_ok=True)
   165	    highlights_path = run_dir / "selected-highlights.jsonl"
   166	    documents_path = run_dir / "selected-documents.jsonl"
   167	    summary_path = review_dir / "summary.md"
   168	
   169	    write_jsonl_atomic(highlights_path, [row.model_dump(mode="json") for row in highlights])
   170	    write_jsonl_atomic(documents_path, [row.model_dump(mode="json") for row in documents])
   171	
   172	    titles = sorted({highlight.document_title or "Untitled" for highlight in highlights})
   173	    summary_count = sum(1 for highlight in highlights if highlight.evidence_kind == "document_summary")
   174	    brief = "\n".join(
   175	        [
   176	            f"# Opinion run {run_id}",
   177	            "",
   178	            f"Window: {iso_utc(window_start)} to {iso_utc(window_end)}",
   179	            f"Selected evidence: {len(highlights)}",
   180	            f"Selected document summaries: {summary_count}",
   181	            f"Selected documents: {len(documents)}",
   182	            "",
   183	            "Documents:",
   184	            *[f"- {title}" for title in titles],
   185	        ]
   186	    )
   187	    write_text_atomic(summary_path, brief)
   188	    return RunBundle(
   189	        run_dir=run_dir,
   190	        review_summary_md=summary_path,
   191	        selected_highlights_jsonl=highlights_path,
   192	        selected_documents_jsonl=documents_path,
   193	        highlights=highlights,
   194	        documents=documents,
   195	    )
   196	
   197	
   198	def finalize_run_dir(run_paths: RunPaths, run_id: str, final_payload: dict) -> Path:
   199	    """Move a terminal run out of active/ and persist its final payload."""
   200	    from opinions_agent.fsio import write_json_atomic
   201	
   202	    completed_dir = run_paths.completed_run_dir(run_id)
   203	    completed_dir.mkdir(parents=True, exist_ok=True)
   204	    write_json_atomic(completed_dir / "final.json", final_payload)
   205	    active_dir = run_paths.active_run_dir(run_id)
   206	    if active_dir.exists():
   207	        shutil.rmtree(active_dir)
   208	    return completed_dir
   209	
   210	
   211	def cleanup_completed_runs(run_paths: RunPaths, *, retention_days: int, now: datetime | None = None) -> int:
   212	    """Delete completed run directories older than the retention window. Returns directories removed."""
   213	    if not run_paths.completed_dir.exists():
   214	        return 0
   215	    cutoff = (now or datetime.now(UTC)) - timedelta(days=retention_days)
   216	    removed = 0
   217	    for run_dir in run_paths.completed_dir.iterdir():
   218	        if not run_dir.is_dir():
   219	            continue
   220	        modified = datetime.fromtimestamp(run_dir.stat().st_mtime, tz=UTC)
   221	        if modified < cutoff:
   222	            shutil.rmtree(run_dir)
   223	            removed += 1
   224	    return removed

