   373	async def _poll(settings, SessionLocal, *, once: bool) -> None:
   374	    telegram = TelegramClient(settings.telegram_bot_token)
   375	    agent = ThinHarnessOpinionAgent()
   376	    while True:
   377	        with SessionLocal() as session:
   378	            offset = next_update_offset(session)
   379	        updates = await telegram.get_updates(offset=offset)
   380	        for update in updates:
   381	            with SessionLocal() as session:
   382	                await handle_telegram_update(
   383	                    session=session,
   384	                    settings=settings,
   385	                    agent=agent,
   386	                    telegram=telegram,
   387	                    update=update,
   388	                )
   389	        if once:
   390	            return
