   128	def _blocking_segment(segments: list[list[HighlightRow]], target: float) -> int:
   129	    candidates = [(len(segment) - target, len(segment), -index, index) for index, segment in enumerate(segments)]
   130	    return max(candidates)[-1]
   131	
   132	
   133	def _best_boundaries(
   134	    segments: list[list[HighlightRow]],
   135	    batch_count: int,
   136	    total_rows: int,
   137	) -> list[list[list[HighlightRow]]] | None:
   138	    target = total_rows / batch_count
   139	    low = math.floor(target * 0.5)
   140	    high = math.ceil(target * 1.5)
   141	    candidates: list[tuple[tuple, list[list[list[HighlightRow]]]]] = []
   142	
   143	    def search(start: int, batches_left: int, built: list[list[list[HighlightRow]]]) -> None:
   144	        if batches_left == 0:
   145	            if start != len(segments):
   146	                return
   147	            row_counts = [sum(len(segment) for segment in batch) for batch in built]
   148	            doc_counts = [len({row.document_id for segment in batch for row in segment}) for batch in built]
   149	            boundaries = tuple(batch[-1][-1].highlight_id for batch in built[:-1])
   150	            rank = (
   151	                max(abs(count - target) for count in row_counts),
   152	                max(doc_counts) - min(doc_counts),
   153	                boundaries,
   154	            )
   155	            candidates.append((rank, [list(batch) for batch in built]))
   156	            return
   157	        maximum_end = len(segments) - batches_left + 1
   158	        for end in range(start + 1, maximum_end + 1):
   159	            batch = segments[start:end]
   160	            row_count = sum(len(segment) for segment in batch)
   161	            doc_count = len({row.document_id for segment in batch for row in segment})
   162	            if row_count > MAX_EVIDENCE_ROWS or doc_count > MAX_DOCUMENTS or row_count > high:
   163	                break
   164	            if row_count < low:
   165	                continue
   166	            search(end, batches_left - 1, [*built, batch])
   167	
   168	    search(0, batch_count, [])
   169	    return min(candidates, key=lambda candidate: candidate[0])[1] if candidates else None
