   202	def build_turn_prompt(run_id: str, context: Any, prompt_fragment: str | None) -> str:
   203	    if prompt_fragment:
   204	        return f"""Continue opinion run {run_id} with this app-provided Telegram response context:
   205	
   206	{prompt_fragment}
   207	"""
   208	    return f"""Start opinion run {run_id}.
   209	
   210	Run summary:
   211	{context.run_summary}
   212	
   213	Run inputs:
   214	- Selected evidence (read all rows): {context.selected_highlights_jsonl}
   215	- Selected documents: {context.selected_documents_jsonl}
   216	- Current opinions: {context.opinions_md}
   217	- Opinion provenance for targeted opinion_id lookups: {context.sources_jsonl}
   218	- Decision log (append-only, do not read): {context.decisions_jsonl}
   219	- Global corpus indexes for historical context: {context.documents_jsonl} and {context.highlights_jsonl}
   220	- Full document content for bounded source-context checks when the selected packet visibly signals missing context:
   221	  {context.documents_dir}
   222	- Memory notes: {context.memory_dir}
   223	
   224	Begin by reading all selected evidence rows.
   225	"""
   226	
