   952	def _fail_run(session: Session, run: OpinionRun, reason: str) -> None:
   953	    if run.status in NON_TERMINAL_RUN_STATUSES:
   954	        run.status = RunStatus.FAILED.value
   955	    run.failure_reason = "run_failed" if run.cycle_id else reason
   956	    _stop_cycle(session, run, "run_failed", "The opinion run stopped and needs recovery.")
   957	    session.commit()
   958	
   959	
   960	def _set_batch_status(session: Session, run: OpinionRun, status: BatchStatus) -> None:
   961	    if not run.cycle_id:
   962	        return
   963	    batch = session.scalar(
   964	        select(OpinionBatch).where(
   965	            OpinionBatch.cycle_id == run.cycle_id,
   966	            OpinionBatch.batch_number == run.batch,
   967	        )
   968	    )
   969	    if batch is not None:
   970	        batch.status = status.value
