   517	async def _send_idempotent(
   518	    *,
   519	    session: Session,
   520	    settings: Settings,
   521	    telegram: TelegramSender,
   522	    key: str,
   523	    run_id: str,
   524	    spec: TelegramMessageSpec,
   525	) -> None:
   526	    if settings.telegram_allowed_chat_id is None:
   527	        raise ValueError("TELEGRAM_ALLOWED_CHAT_ID is required to send messages")
   528	    existing = session.scalar(select(TelegramInteraction).where(TelegramInteraction.idempotency_key == key))
   529	    if existing and existing.message_id is not None:
   530	        return
   531	    if existing and existing.status == "sending":
   532	        existing.status = "uncertain"
   533	        session.commit()
   534	        return
   535	    if existing and existing.status == "uncertain":
   536	        result = session.execute(
   537	            update(TelegramInteraction)
   538	            .where(TelegramInteraction.id == existing.id, TelegramInteraction.status == "uncertain")
   539	            .values(status="sending", updated_at=utcnow())
   540	        )
   541	        session.commit()
   542	        if int(getattr(result, "rowcount", 0)) != 1:
   543	            return
   544	        session.refresh(existing)
   545	    intent = existing or TelegramInteraction(
   546	        direction="outbound",
   547	        idempotency_key=key,
   548	        opinion_run_id=run_id,
   549	        chat_id=settings.telegram_allowed_chat_id,
   550	        text=spec.text,
   551	        raw=spec.model_dump(mode="json"),
   552	        status="sending",
   553	    )
   554	    session.add(intent)
   555	    session.commit()
   556	    message_id = await telegram.send_message(settings.telegram_allowed_chat_id, spec)
   557	    intent.message_id = message_id
   558	    intent.status = "sent"
   559	    session.add(intent)
   560	    session.commit()
   561	
   562	
   563	async def handle_telegram_update(
   564	    *,
   565	    session: Session,
   566	    settings: Settings,
   567	    agent: OpinionAgent,
   568	    telegram: TelegramSender,
   569	    update: dict[str, Any],
   570	) -> str:
   571	    update_id = update.get("update_id")
   572	    if update_id is None:
   573	        return "ignored"
   574	    inbound = TelegramInteraction(direction="inbound", update_id=int(update_id), raw=update, status="received")
   575	    try:
   576	        session.add(inbound)
   577	        session.flush()
   578	    except IntegrityError:
   579	        session.rollback()
   580	        return "duplicate"
   581	
   582	    if "callback_query" in update:
   583	        result = await _handle_callback(session, settings, agent, telegram, update["callback_query"], inbound)
   584	    elif "message" in update:
   585	        result = await _handle_message(session, settings, agent, telegram, update["message"], inbound)
   586	    else:
   587	        result = "ignored"
   588	    session.commit()
   589	    return result
   590	
   591	
   592	async def _handle_callback(
   593	    session: Session,
   594	    settings: Settings,
   595	    agent: OpinionAgent,
   596	    telegram: TelegramSender,
   597	    callback: dict[str, Any],
   598	    inbound: TelegramInteraction,
   599	) -> str:
   600	    callback_id = str(callback["id"])
   601	    if session.scalar(select(TelegramInteraction).where(TelegramInteraction.callback_query_id == callback_id)):
   602	        return "duplicate"
   603	    message = callback.get("message") or {}
   604	    chat_id = int((message.get("chat") or {}).get("id") or 0)
   605	    message_id = message.get("message_id")
   606	    data = str(callback.get("data") or "")
   607	    inbound.callback_query_id = callback_id
   608	    inbound.chat_id = chat_id
   609	    inbound.message_id = message_id
   610	    inbound.text = data
   611	    if not _allowed_chat(settings, chat_id):
   612	        await _answer_callback_query_best_effort(telegram, callback_id, "Not allowed")
   613	        return "forbidden"
   614	    if message_id is None:
   615	        await _answer_callback_query_best_effort(telegram, callback_id, "This message is no longer pending")
   616	        return "stale"
   617	    outbound = _find_outbound_message(session, chat_id=chat_id, message_id=message_id)
   618	    if outbound is None or outbound.opinion_run_id is None:
   619	        await _answer_callback_query_best_effort(telegram, callback_id, "This message is no longer pending")
   620	        return "stale"
   621	    button_text = _button_text(outbound, data)
   622	    if button_text is None:
   623	        await _answer_callback_query_best_effort(telegram, callback_id, "Unsupported action")
   624	        return "ignored"
   625	    run = session.get(OpinionRun, outbound.opinion_run_id)
   626	    if run is None or run.status != RunStatus.AWAITING_USER.value:
   627	        await _answer_callback_query_best_effort(telegram, callback_id, "This run is no longer awaiting input")
   628	        return "stale"
   629	    _record_response(inbound, outbound, user_action=button_text, callback_data=data)
   630	    await _answer_callback_query_best_effort(telegram, callback_id, button_text)
   631	    await telegram.edit_message_text(
   632	        chat_id,
   633	        message_id,
   634	        _addressed_message_text(outbound.text or "", button_text),
   635	    )
   636	    if _current_turn_ready(session, run):
   637	        return await _resume_from_telegram(
   638	            session=session,
   639	            settings=settings,
   640	            agent=agent,
   641	            telegram=telegram,
   642	            run=run,
   643	            prompt_fragment=_responses_prompt(session, run),
   644	            result="resumed",
   645	        )
   646	    return "recorded"
   647	
   648	
   649	async def _answer_callback_query_best_effort(
   650	    telegram: TelegramSender, callback_query_id: str, text: str | None = None
   651	) -> None:
   652	    try:
   653	        await telegram.answer_callback_query(callback_query_id, text)
   654	    except Exception:
   655	        pass
   656	
   657	
   658	async def _handle_message(
   659	    session: Session,
   660	    settings: Settings,
   661	    agent: OpinionAgent,
   662	    telegram: TelegramSender,
   663	    message: dict[str, Any],
   664	    inbound: TelegramInteraction,
   665	) -> str:
   666	    chat_id = int((message.get("chat") or {}).get("id") or 0)
   667	    inbound.chat_id = chat_id
   668	    inbound.message_id = message.get("message_id")
   669	    inbound.text = message.get("text")
   670	    if not _allowed_chat(settings, chat_id):
   671	        return "forbidden"
   672	    text = (message.get("text") or "").strip()
   673	    if not text:
   674	        return "ignored"
   675	    active = find_active_run(session)
   676	    if text in {"GO", "SKIP"} and active is not None and active.status == RunStatus.AWAITING_USER.value:
   677	        return await _resume_from_telegram(
   678	            session=session,
   679	            settings=settings,
   680	            agent=agent,
   681	            telegram=telegram,
   682	            run=active,
   683	            prompt_fragment=f"Telegram command received.\n\nCommand:\n{text}",
   684	            result=text.lower(),
   685	        )
   686	
   687	    reply_to = (message.get("reply_to_message") or {}).get("message_id")
   688	    if reply_to is None:
   689	        return "no_pending_run"
   690	    outbound = _find_outbound_message(session, chat_id=chat_id, message_id=reply_to)
   691	    if outbound is None or outbound.opinion_run_id is None:
   692	        return "no_pending_run"
   693	    run = session.get(OpinionRun, outbound.opinion_run_id)
   694	    if run is None or run.status != RunStatus.AWAITING_USER.value:
   695	        return "stale"
   696	    _record_response(inbound, outbound, user_reply=text)
   697	    await telegram.edit_message_text(
   698	        chat_id,
   699	        int(reply_to),
   700	        _addressed_message_text(outbound.text or "", "Reply received"),
   701	    )
   702	    if _current_turn_ready(session, run):
   703	        return await _resume_from_telegram(
   704	            session=session,
   705	            settings=settings,
   706	            agent=agent,
   707	            telegram=telegram,
   708	            run=run,
   709	            prompt_fragment=_responses_prompt(session, run),
   710	            result="resumed",
   711	        )
   712	    return "recorded"
   713	
   714	
   715	async def _resume_from_telegram(
   716	    *,
   717	    session: Session,
   718	    settings: Settings,
   719	    agent: OpinionAgent,
   720	    telegram: TelegramSender,
   721	    run: OpinionRun,
   722	    prompt_fragment: str,
   723	    result: str,
   724	) -> str:
   725	    if not _claim_awaiting_run(session, run):
   726	        return "already_resuming"
   727	    try:
   728	        await _run_agent_turn(
   729	            session=session,
   730	            settings=settings,
   731	            agent=agent,
   732	            telegram=telegram,
   733	            run=run,
   734	            prompt_fragment=prompt_fragment,
   735	        )
   736	        return result
   737	    except Exception as exc:
   738	        _fail_run(session, run, str(exc))
   739	        await send_cycle_failure_notice(session=session, settings=settings, telegram=telegram, run=run)
   740	        raise
   741	
   742	
   743	def _claim_awaiting_run(session: Session, run: OpinionRun) -> bool:
   744	    now = utcnow()
   745	    result = session.execute(
   746	        update(OpinionRun)
   747	        .where(OpinionRun.id == run.id, OpinionRun.status == RunStatus.AWAITING_USER.value)
   748	        .values(
   749	            status=RunStatus.RUNNING_AGENT.value,
   750	            lease_owner=uuid4().hex,
   751	            lease_expires_at=now + timedelta(minutes=15),
   752	            updated_at=now,
   753	        )
   754	    )
   755	    session.commit()
   756	    if int(getattr(result, "rowcount", 0)) != 1:
   757	        session.refresh(run)
   758	        return False
   759	    session.refresh(run)
   760	    return True

