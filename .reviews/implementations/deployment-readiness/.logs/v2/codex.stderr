   115	
   116	def validate_web_settings(settings: Settings) -> None:
   117	    """Reject incomplete or unsafe Railway web configuration."""
   118	    if settings.environment not in {"staging", "prod"}:
   119	        raise ValueError("OPINIONS_ENVIRONMENT must be staging or prod")
   120	    required = {
   121	        "DATABASE_URL": settings.database_url,
   122	        "RAILWAY_VOLUME_MOUNT_PATH": str(settings.volume_mount_path or ""),
   123	        "READWISE_TOKEN": settings.readwise_token,
   124	        "TELEGRAM_BOT_TOKEN": settings.telegram_bot_token,
   125	        "TELEGRAM_ALLOWED_CHAT_ID": str(settings.telegram_allowed_chat_id or ""),
   126	        "TELEGRAM_WEBHOOK_SECRET": settings.telegram_webhook_secret,
   127	        "OPINIONS_START_SECRET": settings.opinions_start_secret,
   128	        "OPENAI_API_KEY": _env("OPENAI_API_KEY"),
   129	        "OPINIONS_REPO_URL": settings.opinions_repo_url,
   130	        "OPINIONS_GIT_TOKEN": settings.opinions_git_token,
   131	        "OPINIONS_REPO_BRANCH": settings.opinions_repo_branch,
   132	        "OPINIONS_TARGET_FILE": settings.opinions_target_file,
   133	        "OPINIONS_SOURCES_FILE": settings.opinions_sources_file,
   134	        "OPINIONS_INITIAL_EVIDENCE_AFTER": settings.initial_evidence_after,
   135	    }
   136	    missing = sorted(name for name, value in required.items() if not value)
   137	    if missing:
   138	        raise ValueError("missing Railway web settings: " + ", ".join(missing))
   139	    if "@" in settings.opinions_repo_url.partition("://")[2].partition("/")[0]:
   140	        raise ValueError("OPINIONS_REPO_URL must not contain credentials")
   141	    if settings.use_fake_telegram or settings.local_tracing_enabled:
   142	        raise ValueError("Railway web cannot use fake Telegram or local plaintext tracing")
   143	    expected_target = "TEST_OPINIONS.md" if settings.environment == "staging" else "OPINIONS.md"
   144	    if settings.opinions_target_file != expected_target:
   145	        raise ValueError(f"{settings.environment} requires OPINIONS_TARGET_FILE={expected_target}")
   146	    if settings.opinions_sources_file != "OPINIONS_SOURCES.jsonl":
   147	        raise ValueError("Railway web requires OPINIONS_SOURCES_FILE=OPINIONS_SOURCES.jsonl")
   148	    if settings.environment == "prod" and not (settings.braintrust_api_key and settings.braintrust_project_id):
   149	        raise ValueError("production requires BRAINTRUST_API_KEY and BRAINTRUST_PROJECT_ID")
   150	
   151	
   152	def validate_cron_settings(settings: Settings) -> None:
   153	    if not settings.opinions_start_url or not settings.opinions_start_secret:
   154	        raise ValueError("OPINIONS_START_URL and OPINIONS_START_SECRET are required")

