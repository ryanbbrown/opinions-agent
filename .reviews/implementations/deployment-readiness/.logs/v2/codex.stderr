    74	def transition(run: OpinionRun, next_status: RunStatus) -> None:
    75	    allowed = VALID_TRANSITIONS[run.status]
    76	    if next_status.value not in allowed:
    77	        raise ValueError(f"invalid opinion run transition: {run.status} -> {next_status.value}")
    78	    run.status = next_status.value
