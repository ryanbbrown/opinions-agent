   228	def _default_rules_path() -> Path:
   229	    cwd_rules = Path.cwd() / "RULES.md"
   230	    if cwd_rules.exists():
   231	        return cwd_rules
   232	    source_tree_rules = Path(__file__).resolve().parents[2] / "RULES.md"
   233	    if source_tree_rules.exists():
   234	        return source_tree_rules
   235	    raise FileNotFoundError("RULES.md not found; run from the project root or pass rules_path")

