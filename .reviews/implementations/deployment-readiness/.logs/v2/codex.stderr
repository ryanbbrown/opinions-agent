   159	"""
   160	
   161	ARTIFACT_BOUNDARY_INSTRUCTIONS = """\
   162	## Artifact And Durability Boundaries
   163	
   164	- You may write/edit only OPINIONS.md, OPINIONS_SOURCES.jsonl, and opinion-decisions.jsonl.
   165	- OPINIONS_SOURCES.jsonl rows are JSON objects with required fields opinion_id, evidence_id, document_id,
