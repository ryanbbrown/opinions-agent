   231	        write_paths=[str(path) for path in write_paths],
   232	        output_dir=str(context.run_dir / ".thinharness" / "outputs"),
   233	        output_type=NativeOutput(AgentTurnOutput),
   234	        output_mode="native",
   235	        subagents=[build_critic_subagent(context=context)],
   236	        local_trace_dir=str(settings.local_trace_dir),
   237	        local_tracing=settings.local_tracing_enabled,
   238	        tracing=[tracing] if tracing is not None else [],
   239	    )
   240	
   241	
   242	async def _run_harness(
   243	    *,
   244	    prompt: str,
   245	    context: AgentReadContext,
   246	    settings: Settings,
   247	    resume_state: dict | None,
   248	) -> tuple[AgentTurnOutput, dict | None]:
   249	    from thinharness import Harness
   250	
   251	    config = build_harness_config(context=context, settings=settings)
   252	    result = await Harness(config, tools=[build_validation_tool(settings=settings, run_dir=context.run_dir)]).run(
   253	        prompt,
   254	        resume_from=resume_state,
   255	    )
   256	    output = (
   257	        result.output
   258	        if isinstance(result.output, AgentTurnOutput)
   259	        else AgentTurnOutput.model_validate(result.output)
   260	    )
   261	    return output, result.resume_state
   262	
   263	
   264	def _common_root(paths: list[Path]) -> Path:
   265	    resolved = [path.expanduser().resolve() for path in paths]
   266	    try:
   267	        common = os.path.commonpath([str(path) for path in resolved])
   268	    except ValueError as exc:
   269	        raise ValueError(f"agent read/write paths do not share a common root: {resolved}") from exc
   270	    return Path(common)
   271	
   272	
   273	class DeterministicOpinionAgent(OpinionAgent):
   274	    """Deterministic fake agent for tests and local smoke runs."""
   275	
   276	    async def run_turn(
   277	        self,
   278	        *,
   279	        run_id: str,
   280	        context: AgentReadContext,
   281	        settings: Settings,
   282	        prompt_fragment: str | None,
   283	        resume_state: dict | None,
   284	    ) -> tuple[AgentTurnOutput, dict | None]:
   285	        if prompt_fragment is None:
   286	            return _deterministic_awaiting_output(context), {"model": "deterministic", "run_id": run_id}
   287	        if "\nSKIP\n" in f"\n{prompt_fragment.strip()}\n":
   288	            _append_decision(context, run_id, "skipped")
   289	            return AgentTurnOutput(
   290	                status="done",
   291	                telegram_messages=[TelegramMessageSpec(text="Skipped this opinion run; no artifact changes.")],
   292	            ), resume_state
   293	        _apply_deterministic_edit(context, run_id)
   294	        run_artifact_validation(settings=settings, run_dir=context.run_dir)
   295	        return AgentTurnOutput(
   296	            status="done",
   297	            telegram_messages=[TelegramMessageSpec(text="Applied approved opinion updates.")],
   298	        ), resume_state
   299	
   300	
   301	def _deterministic_awaiting_output(context: AgentReadContext) -> AgentTurnOutput:
   302	    highlights = read_jsonl(context.selected_highlights_jsonl)
   303	    if not highlights:
   304	        return AgentTurnOutput(status="done", telegram_messages=[TelegramMessageSpec(text="No selected evidence.")])
   305	    first = highlights[0]
   306	    title = escape(str(first.get("document_title") or "Untitled"))
   307	    text = escape(str(first["text"]))
   308	    highlight_id = escape(str(first["highlight_id"]))
   309	    return AgentTurnOutput(
   310	        status="awaiting_user",
   311	        telegram_messages=[
   312	            TelegramMessageSpec(
   313	                text=(
   314	                    "<b>Add Opinion #1</b>\n"
   315	                    "<i>Section:</i> Agentic Software\n\n"
   316	                    "<b>Opinion</b>\n"
   317	                    f"{text} Deterministic opinion.\n\n"
   318	                    "<b>Sources</b>\n"
   319	                    f"{title}\n\n"
   320	                    "<blockquote expandable>\n"
   321	                    "<b>Evidence</b>\n\n"
   322	                    f"{title} — {highlight_id}\n"
   323	                    f"{text}\n"
   324	                    "</blockquote>"
   325	                ),
   326	                buttons=[
   327	                    TelegramButtonSpec(text="Approve", callback_data="approve:add-deterministic-opinion"),
   328	                    TelegramButtonSpec(text="Reject", callback_data="reject:add-deterministic-opinion"),
   329	                ],
   330	            )
   331	        ],
   332	    )
   333	
   334	
   335	def _apply_deterministic_edit(context: AgentReadContext, run_id: str) -> None:
   336	    highlights = read_jsonl(context.selected_highlights_jsonl)
   337	    if not highlights:
   338	        return
   339	    first = highlights[0]
   340	    doc = load_opinions(context.opinions_md)
   341	    existing_ids = {opinion.opinion_id for opinion in doc.opinions}
   342	    opinion_id = next_opinion_id(existing_ids)
   343	    opinion = Opinion(
   344	        opinion_id=opinion_id,
   345	        section="Agentic Software",
   346	        text=f"{first['text']} Deterministic opinion.",
   347	        sources=[first["highlight_id"]],
   348	    )
   349	    updated = OpinionsDocument(preamble=doc.preamble, opinions=[*doc.opinions, opinion])
   350	    write_text_atomic(context.opinions_md, updated.render())
   351	    sources = read_jsonl(context.sources_jsonl)
   352	    sources.append(
   353	        {
   354	            "opinion_id": opinion_id,
   355	            "evidence_id": first["highlight_id"],
   356	            "document_id": first.get("document_id"),
   357	            "document_title": first.get("document_title"),
   358	            "source_url": first.get("source_url"),
   359	            "evidence_text": first.get("text"),
   360	            "added_at": first.get("highlighted_at"),
   361	        }
   362	    )
   363	    write_jsonl_atomic(context.sources_jsonl, sources)
   364	    _append_decision(context, run_id, "approved", opinion_id=opinion_id, evidence_id=first["highlight_id"])
   365	
   366	
   367	def _append_decision(
   368	    context: AgentReadContext,
   369	    run_id: str,
   370	    decision: str,
   371	    *,
   372	    opinion_id: str | None = None,
   373	    evidence_id: str | None = None,
   374	) -> None:
   375	    append_jsonl(
   376	        context.decisions_jsonl,
   377	        [
   378	            {
   379	                "run_id": run_id,
   380	                "decision": decision,
   381	                "affected_opinion_ids": [opinion_id] if opinion_id else [],
   382	                "supporting_evidence_ids": [evidence_id] if evidence_id else [],
   383	                "summary": f"Deterministic {decision} decision.",
   384	            }
   385	        ],
   386	    )

