   474	async def send_cycle_failure_notice(
   475	    *,
   476	    session: Session,
   477	    settings: Settings,
   478	    telegram: TelegramSender,
   479	    run: OpinionRun,
   480	) -> None:
   481	    if not run.cycle_id:
   482	        return
   483	    cycle = session.get(OpinionCycle, run.cycle_id)
   484	    code = cycle.failure_code if cycle and cycle.failure_code else "run_failed"
   485	    await _send_idempotent(
   486	        session=session,
   487	        settings=settings,
   488	        telegram=telegram,
   489	        key=f"opinion-cycle:{run.cycle_id}:batch:{run.batch}:stopped:{code}",
   490	        run_id=run.id,
   491	        spec=TelegramMessageSpec(
   492	            text=(
   493	                f"Opinion cycle {run.cycle_id} stopped at batch {run.batch}. "
   494	                f"Failure code: {code}. Retry with: opinions-agent retry-cycle {run.cycle_id}"
   495	            )
   496	        ),
   497	    )
