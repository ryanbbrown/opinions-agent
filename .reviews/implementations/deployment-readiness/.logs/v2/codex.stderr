   265	async def _run_agent_turn(
   266	    *,
   267	    session: Session,
   268	    settings: Settings,
   269	    agent: OpinionAgent,
   270	    telegram: TelegramSender,
   271	    run: OpinionRun,
   272	    prompt_fragment: str | None,
   273	) -> None:
   274	    if run.status == RunStatus.PENDING_AGENT.value:
   275	        transition(run, RunStatus.RUNNING_AGENT)
   276	        run.lease_owner = uuid4().hex
   277	        run.lease_expires_at = utcnow() + timedelta(minutes=15)
   278	        session.commit()
   279	    context = build_read_context(settings, _run_dir(run, settings))
   280	    output, resume_state = await agent.run_turn(
   281	        run_id=run.id,
   282	        context=context,
   283	        settings=settings,
   284	        prompt_fragment=prompt_fragment,
   285	        resume_state=run.resume_state,
   286	    )
   287	    run.agent_output = output.model_dump(mode="json")
   288	    run.resume_state = resume_state
   289	    run.turn_seq += 1
   290	    run.attempts += 1
   291	    if prompt_fragment is None and run.turn_seq == 1:
   292	        _write_initial_telegram_review(_run_dir(run, settings), output)
   293	    if output.status == "awaiting_user":
   294	        transition(run, RunStatus.AWAITING_USER)
   295	        run.lease_owner = None
   296	        run.lease_expires_at = None
   297	        _set_batch_status(session, run, BatchStatus.AWAITING_USER)
   298	        session.commit()
   299	        await send_agent_messages(session=session, settings=settings, telegram=telegram, run=run, output=output)
   300	        return
   301	    if output.status == "blocked":
   302	        transition(run, RunStatus.BLOCKED)
   303	        run.lease_owner = None
   304	        run.lease_expires_at = None
   305	        run.failure_reason = output.notes or "agent returned blocked"
   306	        _stop_cycle(session, run, "agent_blocked", "The opinion agent needs manual intervention.")
   307	        session.commit()
   308	        await send_agent_messages(session=session, settings=settings, telegram=telegram, run=run, output=output)
   309	        return
   310	    if output.status == "done":
   311	        session.commit()
   312	        await _complete_done_run(session=session, settings=settings, telegram=telegram, run=run, output=output)
   313	        return
   314	    raise ValueError(f"unsupported agent status: {output.status}")
