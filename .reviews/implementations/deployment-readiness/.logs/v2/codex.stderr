    31	        opinions_git_token="git-token",
    32	        initial_evidence_after="2026-06-01T00:00:00+00:00",
    33	        opinions_repo_url="https://github.com/example/opinions.git",
    34	        opinions_target_file="TEST_OPINIONS.md" if environment == "staging" else "OPINIONS.md",
    35	        local_tracing_enabled=False,
    36	        use_fake_telegram=False,
