    32	def rows(sizes: list[int]) -> list[HighlightRow]:
    33	    result: list[HighlightRow] = []
    34	    index = 0
    35	    for document_index, size in enumerate(sizes):
    36	        for _ in range(size):
    37	            result.append(
    38	                HighlightRow(
    39	                    highlight_id=f"rw:{index:03d}",
    40	                    document_id=f"reader:{document_index:03d}",
    41	                    reader_id=str(document_index),
    42	                    text=f"evidence {index}",
    43	                    highlighted_at=f"2026-06-{1 + index // 24:02d}T{index % 24:02d}:00:00+00:00",
    44	                )
    45	            )
    46	            index += 1
    47	    return result
    48	
    49	
    50	def counts(sizes: list[int]) -> list[int]:
    51	    return [len(batch.rows) for batch in partition_evidence(rows(sizes))]
    52	
    53	
    54	def test_partition_thresholds_and_balance() -> None:
    55	    assert counts([3] * 16 + [1]) == [49]
    56	    assert counts([1] * 20) == [10, 10]
    57	    assert counts([5] * 10) == [25, 25]
    58	    assert counts([51]) == [26, 25]
    59	    assert len(counts([1] * 41)) == 3
    60	    assert len(counts([101])) == 3
    61	
    62	
    63	def test_partition_splits_blocking_document_but_keeps_acceptable_boundaries() -> None:
    64	    assert counts([45, 5]) == [25, 25]
    65	    assert counts([23, 27]) == [23, 27]
