    22	@dataclass(frozen=True)
    23	class RunPaths:
    24	    runs_dir: Path
    25	
    26	    @property
    27	    def active_dir(self) -> Path:
    28	        return self.runs_dir / "active"
    29	
    30	    @property
    31	    def completed_dir(self) -> Path:
    32	        return self.runs_dir / "completed"
    33	
