   984	def _complete_cycle_batch(
   985	    session: Session,
   986	    settings: Settings,
   987	    run: OpinionRun,
   988	    commit_sha: str | None,
   989	    validation_summary: str,
   990	) -> None:
   991	    from opinions_agent.cycles import complete_cycle_directory
   992	    from opinions_agent.fsio import write_json_atomic
   993	
   994	    if not run.cycle_id:
   995	        return
   996	    cycle = session.get(OpinionCycle, run.cycle_id)
   997	    batch = session.scalar(
   998	        select(OpinionBatch).where(
   999	            OpinionBatch.cycle_id == run.cycle_id,
  1000	            OpinionBatch.batch_number == run.batch,
  1001	        )
  1002	    )
  1003	    if cycle is None or batch is None:
  1004	        raise ValueError("cycle batch state is missing")
  1005	    batch.status = BatchStatus.COMPLETED.value
  1006	    batch.successful_run_id = run.id
  1007	    run_dir = _run_dir(run, settings)
  1008	    batch.bundle_path = str(run_dir)
  1009	    write_json_atomic(
  1010	        run_dir / "final.json",
  1011	        {
  1012	            "run_id": run.id,
  1013	            "status": RunStatus.COMPLETED.value,
  1014	            "commit_sha": commit_sha,
  1015	            "validation": validation_summary,
  1016	        },
  1017	    )
  1018	    next_batch = session.scalar(
  1019	        select(OpinionBatch).where(
