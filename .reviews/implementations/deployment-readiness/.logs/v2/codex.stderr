   144	def build_evidence_fetch_tool(*, context: AgentReadContext):
   145	    """Expose cited rows and fixed same-document context to the critic only."""
   146	    from thinharness import ToolResult, ToolSpec
   147	
   148	    class GetEvidenceArgs(BaseModel):
   149	        evidence_ids: list[str]
   150	
   151	    def format_row(row: dict) -> str:
   152	        note = f"\n  Ryan's note: {row['note']}" if row.get("note") else ""
   153	        return (
   154	            f"- {row.get('document_title') or 'Untitled'} "
   155	            f"({row.get('evidence_kind') or 'highlight'}) — {row['highlight_id']}\n"
   156	            f"  {row.get('text') or ''}{note}"
   157	        )
   158	
   159	    async def get_evidence(args: GetEvidenceArgs) -> ToolResult:
   160	        selected = read_jsonl(context.selected_highlights_jsonl)
   161	        selected_by_id = {row["highlight_id"]: row for row in selected}
   162	        fixed_context = read_jsonl(context.critic_context_jsonl)
   163	        blocks: list[str] = []
   164	        unresolved: list[str] = []
   165	        cited_document_ids: list[str] = []
   166	        for evidence_id in args.evidence_ids:
   167	            row = selected_by_id.get(evidence_id)
   168	            if row is None:
   169	                unresolved.append(evidence_id)
   170	                continue
   171	            blocks.append(format_row(row))
   172	            document_id = row.get("document_id")
   173	            if document_id and document_id not in cited_document_ids:
   174	                cited_document_ids.append(document_id)
   175	        parts = [f"Resolved {len(blocks)} of {len(args.evidence_ids)} cited evidence rows."]
   176	        if blocks:
   177	            parts.append("\n".join(blocks))
   178	        cited_ids = set(args.evidence_ids)
   179	        context_blocks: list[str] = []
   180	        for document_id in cited_document_ids:
   181	            rows = [row for row in fixed_context if row.get("document_id") == document_id]
   182	            if not rows:
   183	                continue
   184	            summary = next((row.get("document_summary") for row in rows if row.get("document_summary")), None)
   185	            lines = [f"- {rows[0].get('document_title') or 'Untitled'}"]
   186	            if summary:
   187	                lines.append(f"  Document summary: {summary}")
   188	            uncited = [row for row in rows if row["highlight_id"] not in cited_ids]
   189	            if uncited:
   190	                lines.append("  Other fixed rows from this document (not cited by this draft):")
   191	                lines.extend("  " + format_row(row).replace("\n", "\n  ") for row in uncited)
   192	            context_blocks.append("\n".join(lines))
   193	        if context_blocks:
   194	            parts.append("Source-document context for the cited rows:\n\n" + "\n\n".join(context_blocks))
   195	        if unresolved:
   196	            parts.append("Unresolved IDs (not in this batch): " + ", ".join(unresolved))
   197	        return ToolResult(ok=True, content="\n\n".join(parts))
   198	
   199	    return ToolSpec(
