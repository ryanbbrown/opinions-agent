    80	def partition_evidence(rows: list[HighlightRow]) -> list[PartitionBatch]:
    81	    """Create the smallest legal deterministic partition with balanced row counts."""
    82	    ordered = sorted(
    83	        rows,
    84	        key=lambda row: (
    85	            parse_iso(row.highlighted_at) or datetime.min.replace(tzinfo=UTC),
    86	            row.highlight_id,
    87	        ),
    88	    )
    89	    if not ordered:
    90	        return []
    91	    document_count = len({row.document_id for row in ordered})
    92	    split_required = document_count >= MAX_DOCUMENTS or len(ordered) >= MAX_EVIDENCE_ROWS
    93	    minimum = max(
    94	        2 if split_required else 1,
    95	        math.ceil(document_count / MAX_DOCUMENTS),
    96	        math.ceil(len(ordered) / MAX_EVIDENCE_ROWS),
    97	    )
    98	    groups = _document_groups(ordered)
    99	    for batch_count in range(minimum, len(ordered) + 1):
   100	        segments = [list(group) for group in groups]
   101	        while len(segments) < len(ordered):
   102	            found = _best_boundaries(segments, batch_count, len(ordered))
   103	            if found is not None:
   104	                return [PartitionBatch(rows=[row for segment in batch for row in segment]) for batch in found]
   105	            index = _blocking_segment(segments, len(ordered) / batch_count)
   106	            segment = segments[index]
   107	            if len(segment) <= 1:
   108	                break
   109	            cut = max(1, min(len(segment) - 1, round(len(ordered) / batch_count)))
   110	            segments[index : index + 1] = [segment[:cut], segment[cut:]]
   111	        found = _best_boundaries(segments, batch_count, len(ordered))
   112	        if found is not None:
   113	            return [PartitionBatch(rows=[row for segment in batch for row in segment]) for batch in found]
   114	    raise ValueError("could not create a legal evidence partition")
