    63	def evidence_fingerprint(row: HighlightRow) -> str:
    64	    readable = {
    65	        "document_id": row.document_id,
    66	        "document_title": row.document_title,
    67	        "document_author": row.document_author,
    68	        "document_summary": row.document_summary,
