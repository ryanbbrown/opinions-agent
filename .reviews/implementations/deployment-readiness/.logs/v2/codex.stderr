    80	@app.post("/internal/opinion-cycle/start")
    81	async def start_opinion_cycle(
    82	    response: Response,
    83	    session: Session = Depends(get_session),
    84	    authorization: str | None = Header(default=None),
    85	) -> dict[str, str | int]:
    86	    expected = f"Bearer {settings.opinions_start_secret}"
    87	    if not settings.opinions_start_secret or not secrets.compare_digest(authorization or "", expected):
    88	        raise HTTPException(status_code=401, detail="invalid start secret")
