   972	
   973	def _stop_cycle(session: Session, run: OpinionRun, code: str, summary: str) -> None:
   974	    if not run.cycle_id:
   975	        return
   976	    cycle = session.get(OpinionCycle, run.cycle_id)
   977	    if cycle is not None:
   978	        cycle.status = CycleStatus.STOPPED.value
   979	        cycle.failure_code = code
   980	        cycle.failure_summary = summary
   981	    _set_batch_status(session, run, BatchStatus.STOPPED)
