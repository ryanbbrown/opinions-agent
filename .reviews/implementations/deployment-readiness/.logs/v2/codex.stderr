   658	async def _handle_message(
   659	    session: Session,
   660	    settings: Settings,
   661	    agent: OpinionAgent,
   662	    telegram: TelegramSender,
   663	    message: dict[str, Any],
   664	    inbound: TelegramInteraction,
   665	) -> str:
   666	    chat_id = int((message.get("chat") or {}).get("id") or 0)
   667	    inbound.chat_id = chat_id
   668	    inbound.message_id = message.get("message_id")
   669	    inbound.text = message.get("text")
   670	    if not _allowed_chat(settings, chat_id):
   671	        return "forbidden"
   672	    text = (message.get("text") or "").strip()
   673	    if not text:
   674	        return "ignored"
   675	    active = find_active_run(session)
   676	    if text in {"GO", "SKIP"} and active is not None and active.status == RunStatus.AWAITING_USER.value:
   677	        return await _resume_from_telegram(
   678	            session=session,
   679	            settings=settings,
   680	            agent=agent,
   681	            telegram=telegram,
   682	            run=active,
   683	            prompt_fragment=f"Telegram command received.\n\nCommand:\n{text}",
   684	            result=text.lower(),
   685	        )
   686	
   687	    reply_to = (message.get("reply_to_message") or {}).get("message_id")
   688	    if reply_to is None:
   689	        return "no_pending_run"
   690	    outbound = _find_outbound_message(session, chat_id=chat_id, message_id=reply_to)
   691	    if outbound is None or outbound.opinion_run_id is None:
   692	        return "no_pending_run"
   693	    run = session.get(OpinionRun, outbound.opinion_run_id)
   694	    if run is None or run.status != RunStatus.AWAITING_USER.value:
   695	        return "stale"
   696	    _record_response(inbound, outbound, user_reply=text)
   697	    await telegram.edit_message_text(
   698	        chat_id,
   699	        int(reply_to),
   700	        _addressed_message_text(outbound.text or "", "Reply received"),
   701	    )
   702	    if _current_turn_ready(session, run):
   703	        return await _resume_from_telegram(
   704	            session=session,
   705	            settings=settings,
   706	            agent=agent,
   707	            telegram=telegram,
   708	            run=run,
   709	            prompt_fragment=_responses_prompt(session, run),
   710	            result="resumed",
   711	        )
   712	    return "recorded"
   713	
   714	
   715	async def _resume_from_telegram(
   716	    *,
   717	    session: Session,
   718	    settings: Settings,
   719	    agent: OpinionAgent,
   720	    telegram: TelegramSender,
   721	    run: OpinionRun,
   722	    prompt_fragment: str,
   723	    result: str,
   724	) -> str:
   725	    if not _claim_awaiting_run(session, run):
   726	        return "already_resuming"
   727	    try:
   728	        await _run_agent_turn(
   729	            session=session,
   730	            settings=settings,
   731	            agent=agent,
   732	            telegram=telegram,
   733	            run=run,
   734	            prompt_fragment=prompt_fragment,
   735	        )
   736	        return result
   737	    except Exception as exc:
   738	        _fail_run(session, run, str(exc))
   739	        await send_cycle_failure_notice(session=session, settings=settings, telegram=telegram, run=run)
   740	        raise
   741	
   742	
   743	def _claim_awaiting_run(session: Session, run: OpinionRun) -> bool:
   744	    now = utcnow()
   745	    result = session.execute(
   746	        update(OpinionRun)
   747	        .where(OpinionRun.id == run.id, OpinionRun.status == RunStatus.AWAITING_USER.value)
   748	        .values(
   749	            status=RunStatus.RUNNING_AGENT.value,
   750	            lease_owner=uuid4().hex,
   751	            lease_expires_at=now + timedelta(minutes=15),
   752	            updated_at=now,
   753	        )
   754	    )
   755	    session.commit()
   756	    if int(getattr(result, "rowcount", 0)) != 1:
   757	        session.refresh(run)
   758	        return False
   759	    session.refresh(run)
   760	    return True
   761	
   762	
   763	def _find_outbound_message(session: Session, *, chat_id: int, message_id: int | None) -> TelegramInteraction | None:
   764	    if message_id is None:
   765	        return None
   766	    return session.scalar(
   767	        select(TelegramInteraction).where(
   768	            TelegramInteraction.direction == "outbound",
   769	            TelegramInteraction.chat_id == chat_id,
   770	            TelegramInteraction.message_id == int(message_id),
   771	            TelegramInteraction.status == "sent",
   772	        )
   773	    )
   774	
   775	
   776	def _button_text(outbound: TelegramInteraction, callback_data: str) -> str | None:
   777	    for button in outbound.raw.get("buttons", []):
   778	        if button.get("callback_data") == callback_data:
   779	            return str(button.get("text") or callback_data)
   780	    return None
   781	
   782	
   783	def _addressed_message_text(original_text: str, button_text: str) -> str:
   784	    lines = original_text.splitlines()
   785	    if not lines:
   786	        return _status_line(button_text)
   787	    first = lines[0].strip()
   788	    if first.startswith("<b>") and first.endswith("</b>"):
   789	        title = first.removeprefix("<b>").removesuffix("</b>")
   790	    else:
   791	        title = first
   792	    lines[0] = f"<b>{_status_label(button_text)} - {title}</b>"
   793	    return "\n".join(lines)
   794	
   795	
   796	def _status_line(button_text: str) -> str:
   797	    return f"<b>{_status_label(button_text)}</b>"
   798	
   799	
   800	def _status_label(button_text: str) -> str:
   801	    normalized = button_text.strip().lower()
   802	    if normalized == "approve":
   803	        return "✅ Approved"
   804	    if normalized == "reject":
   805	        return "❌ Rejected"
   806	    if normalized == "reply received":
   807	        return "💬 Reply received"
   808	    return f"Addressed: {button_text}"
   809	
   810	
   811	def _record_response(
   812	    inbound: TelegramInteraction,
   813	    outbound: TelegramInteraction,
   814	    *,
   815	    user_action: str | None = None,
   816	    callback_data: str | None = None,
   817	    user_reply: str | None = None,
   818	) -> None:
   819	    inbound.opinion_run_id = outbound.opinion_run_id
   820	    inbound.status = "recorded"
   821	    inbound.raw = {
   822	        **(inbound.raw or {}),
   823	        "in_response_to_message_id": outbound.message_id,
   824	        "original_text": outbound.text,
   825	        "buttons": outbound.raw.get("buttons", []),
   826	        "user_action": user_action,
   827	        "callback_data": callback_data,
   828	        "user_reply": user_reply,
   829	    }
   830	
   831	
   832	def _current_turn_outbounds(session: Session, run: OpinionRun) -> list[TelegramInteraction]:
   833	    prefix = f"opinion-run:{run.id}:turn:{run.turn_seq}:message:"
   834	    return list(
   835	        session.scalars(
   836	            select(TelegramInteraction)
   837	            .where(
   838	                TelegramInteraction.direction == "outbound",
   839	                TelegramInteraction.opinion_run_id == run.id,
   840	                TelegramInteraction.idempotency_key.like(f"{prefix}%"),
   841	            )
   842	            .order_by(TelegramInteraction.id)
   843	        )
   844	    )
   845	
   846	
   847	def _requires_response(outbound: TelegramInteraction) -> bool:
   848	    return bool(outbound.raw.get("force_reply") or outbound.raw.get("buttons"))
   849	
   850	
   851	def _responses_by_message(session: Session, run: OpinionRun) -> dict[int, TelegramInteraction]:
   852	    responses = list(
   853	        session.scalars(
   854	            select(TelegramInteraction).where(
   855	                TelegramInteraction.direction == "inbound",
   856	                TelegramInteraction.opinion_run_id == run.id,
   857	                TelegramInteraction.status == "recorded",
   858	            )
   859	        )
   860	    )
   861	    by_message: dict[int, TelegramInteraction] = {}
   862	    for response in responses:
   863	        original = (response.raw or {}).get("in_response_to_message_id")
   864	        if original is not None:
   865	            by_message.setdefault(int(original), response)
   866	    return by_message
   867	
   868	
   869	def _current_turn_ready(session: Session, run: OpinionRun) -> bool:
   870	    expected = [outbound for outbound in _current_turn_outbounds(session, run) if _requires_response(outbound)]
   871	    if not expected:
   872	        return False
   873	    responses = _responses_by_message(session, run)
   874	    return all(outbound.message_id in responses for outbound in expected)
   875	
   876	
   877	def _responses_prompt(session: Session, run: OpinionRun) -> str:
   878	    responses = _responses_by_message(session, run)
   879	    blocks = [
   880	        "Telegram responses received.",
   881	        "",
   882	        "Interpretation rules:",
   883	        "- Approve button callbacks are approval for that proposal.",
   884	        "- Reject button callbacks are rejection for that proposal.",
   885	        "- Free-text replies are contextual feedback, not approval. They may request revision, ask for more context, "
   886	        "or explain rejection.",
   887	        "- If a free-text reply asks for changed wording or otherwise modifies a proposal, send a revised proposal "
   888	        "with fresh Approve and Reject buttons before making durable opinion edits.",
   889	        "- Never infer approval from a free-text reply.",
   890	    ]
   891	    for outbound in _current_turn_outbounds(session, run):
   892	        if not _requires_response(outbound) or outbound.message_id not in responses:
   893	            continue
   894	        response = responses[outbound.message_id]
   895	        blocks.extend(
   896	            [
   897	                "",
   898	                f"Original Telegram message_id: {outbound.message_id}",
   899	                "Original message text:",
   900	                outbound.text or "",
   901	                "",
   902	            ]
   903	        )
   904	        if (response.raw or {}).get("user_action"):
   905	            blocks.extend(["User action:", str(response.raw["user_action"])])
   906	            blocks.extend(["Callback data:", str(response.raw.get("callback_data") or "")])
   907	        if (response.raw or {}).get("buttons"):
   908	            blocks.extend(["Buttons sent:", str(response.raw["buttons"])])
   909	        if (response.raw or {}).get("user_reply"):
   910	            blocks.extend(["User reply:", str(response.raw["user_reply"])])
   911	    return "\n".join(blocks)
