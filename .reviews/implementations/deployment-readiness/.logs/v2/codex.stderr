    85	def _run_window(
    86	    settings: Settings,
    87	    *,
    88	    window_start: datetime | None,
    89	    window_end: datetime | None,
    90	    now: datetime | None,
    91	) -> tuple[datetime, datetime]:
    92	    current = now or datetime.now(UTC)
    93	    end = window_end or current
    94	    if window_start is not None:
    95	        return window_start, end
    96	    return end - DEFAULT_WINDOW, end
