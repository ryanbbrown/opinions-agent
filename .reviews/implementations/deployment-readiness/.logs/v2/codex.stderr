   353	async def _cron_trigger(settings) -> None:
   354	    import httpx
   355	
   356	    from opinions_agent.config import validate_cron_settings
   357	
   358	    validate_cron_settings(settings)
   359	    async with httpx.AsyncClient(timeout=600) as client:
   360	        response = await client.post(
   361	            settings.opinions_start_url,
   362	            headers={"Authorization": f"Bearer {settings.opinions_start_secret}"},
   363	        )
   364	    if response.status_code not in {200, 202}:
   365	        raise SystemExit(f"cycle start failed with HTTP {response.status_code}")
   366	    payload = response.json()
   367	    print(
   368	        f"cycle {payload.get('cycle_id')}: {payload.get('status')}, "
   369	        f"{payload.get('batch_count')} batches, {payload.get('result_code')}"
   370	    )
