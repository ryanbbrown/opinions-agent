   296	        boundary = parse_iso(settings.initial_evidence_after)
   297	        if previous is None and boundary is None:
   298	            raise ValueError("OPINIONS_INITIAL_EVIDENCE_AFTER is required for the first cycle")
   299	        cycle = OpinionCycle(
   300	            week_key=week_key(current),
   301	            status=CycleStatus.STARTING.value,
   302	            window_start=previous.window_end if previous else boundary,
   303	            window_end=current,
   304	            initial_evidence_after=boundary if previous is None else previous.initial_evidence_after,
   305	        )
   306	        session.add(cycle)
   307	        session.commit()
   308	        await sync_corpus()
   309	        versions = _eligible_versions(session, settings, cycle)
   310	        batches = partition_evidence([version.row for version in versions])
   311	        _materialize_cycle(session, settings, cycle, versions, batches)
   312	        cycle.status = CycleStatus.ACTIVE.value if batches else CycleStatus.COMPLETED.value
   313	        session.commit()
   314	        if not batches:
   315	            complete_cycle_directory(settings, cycle.id)
   316	        return CycleStartResult(
   317	            cycle_id=cycle.id,
   318	            status=cycle.status,
   319	            batch_count=cycle.batch_count,
   320	            result_code="created" if batches else "no_evidence",
   321	            created=True,
   322	        )
   323	    except Exception:
   324	        if cycle is not None:
   325	            cycle_id = cycle.id
   326	            session.rollback()
   327	            stored_cycle = session.get(OpinionCycle, cycle_id)
   328	            if stored_cycle is None:
   329	                raise
   330	            stored_cycle.status = CycleStatus.STOPPED.value
   331	            stored_cycle.failure_code = "snapshot_failed"
   332	            stored_cycle.failure_summary = "The weekly evidence snapshot failed. Retry the stopped cycle."
   333	            session.commit()
   334	        raise
   335	    finally:
   336	        release_lease(session, "opinion-cycle-start", owner)
   337	
   338	
   339	def _unfinished_cycle(session: Session) -> OpinionCycle | None:
   340	    return session.scalar(
   341	        select(OpinionCycle)
   342	        .where(
   343	            OpinionCycle.status.in_([CycleStatus.STARTING.value, CycleStatus.ACTIVE.value, CycleStatus.STOPPED.value])
   344	        )
   345	        .order_by(OpinionCycle.created_at)
   346	    )
   347	
   348	
   349	def _existing_result(cycle: OpinionCycle) -> CycleStartResult:
   350	    code = "stopped" if cycle.status == CycleStatus.STOPPED.value else "existing"
   351	    return CycleStartResult(cycle.id, cycle.status, cycle.batch_count, code, False)
   352	
   353	
   354	def _eligible_versions(session: Session, settings: Settings, cycle: OpinionCycle) -> list[EvidenceVersion]:
   355	    corpus = CorpusPaths(settings.opinions_data_dir)
   356	    documents = document_by_id(corpus)
   357	    assignments = {(row.evidence_id, row.fingerprint) for row in session.scalars(select(OpinionEvidenceAssignment))}
   358	    versions: list[EvidenceVersion] = []
   359	    boundary = _ensure_utc(cycle.initial_evidence_after) if cycle.initial_evidence_after else None
   360	    for row in _corpus_evidence(corpus):
   361	        if _is_backfill_document(documents.get(row.document_id)):
   362	            continue
   363	        fingerprint = evidence_fingerprint(row)
   364	        key = (row.highlight_id, fingerprint)
   365	        if key in assignments:
   366	            continue
   367	        source_time = parse_iso(row.highlighted_at)
   368	        if boundary is not None and source_time is not None and source_time < boundary:
   369	            session.add(
   370	                OpinionEvidenceAssignment(
   371	                    evidence_id=row.highlight_id,
   372	                    fingerprint=fingerprint,
   373	                    disposition="baseline_ignored",
   374	                )
   375	            )
   376	            continue
   377	        versions.append(EvidenceVersion(row, fingerprint))
   378	    session.commit()
   379	    versions.sort(
   380	        key=lambda version: (
   381	            parse_iso(version.row.highlighted_at) or _ensure_utc(cycle.window_end),
   382	            version.row.highlight_id,
   383	        )
   384	    )
   385	    return versions
   386	
   387	
   388	def _corpus_evidence(corpus: CorpusPaths) -> list[HighlightRow]:
   389	    highlights = read_highlights(corpus)
   390	    document_ids_with_evidence = {row.document_id for row in highlights}
   391	    rows = list(highlights)
   392	    for document in document_by_id(corpus).values():
   393	        if document.document_id in document_ids_with_evidence or _is_backfill_document(document):
   394	            continue
   395	        summary = (document.summary or "").strip()
   396	        saved_at = parse_iso(document.saved_at)
   397	        if document.tags and summary and saved_at is not None:
   398	            rows.append(_document_summary_evidence(document, summary, saved_at))
   399	    return rows
   400	
   401	
   402	def _ensure_utc(value: datetime) -> datetime:
   403	    return value.replace(tzinfo=UTC) if value.tzinfo is None else value.astimezone(UTC)
   404	
   405	
   406	def _materialize_cycle(
   407	    session: Session,
   408	    settings: Settings,
   409	    cycle: OpinionCycle,
   410	    versions: list[EvidenceVersion],
   411	    batches: list[PartitionBatch],
   412	) -> None:
   413	    cycle_dir = settings.runs_dir / "active" / cycle.id
   414	    cycle_dir.mkdir(parents=True, exist_ok=True)
   415	    documents = document_by_id(CorpusPaths(settings.opinions_data_dir))
   416	    version_by_id = {version.row.highlight_id: version for version in versions}
   417	    all_rows_by_doc: dict[str, list[HighlightRow]] = {}
   418	    for version in versions:
   419	        all_rows_by_doc.setdefault(version.row.document_id, []).append(version.row)
   420	    for number, batch in enumerate(batches, start=1):
   421	        batch_dir = cycle_dir / "batches" / str(number)
   422	        review_dir = batch_dir / "review"
   423	        review_dir.mkdir(parents=True, exist_ok=True)
   424	        selected_docs = [documents[doc_id] for doc_id in batch.document_ids if doc_id in documents]
   425	        context_rows = [row for doc_id in batch.document_ids for row in all_rows_by_doc.get(doc_id, [])]
   426	        write_jsonl_atomic(batch_dir / "selected-highlights.jsonl", [row.model_dump(mode="json") for row in batch.rows])
   427	        write_jsonl_atomic(
   428	            batch_dir / "selected-documents.jsonl",
   429	            [row.model_dump(mode="json") for row in selected_docs],
   430	        )
   431	        write_jsonl_atomic(batch_dir / "critic-context.jsonl", [row.model_dump(mode="json") for row in context_rows])
   432	        write_text_atomic(
   433	            review_dir / "summary.md",
   434	            f"# Opinion cycle {cycle.id}, batch {number} of {len(batches)}\n\n"
   435	            f"Window: {iso_utc(cycle.window_start)} to {iso_utc(cycle.window_end)}\n"
   436	            f"Selected evidence: {len(batch.rows)}\nSelected documents: {len(batch.document_ids)}\n",
   437	        )
   438	        model = OpinionBatch(
   439	            cycle_id=cycle.id,
   440	            batch_number=number,
   441	            status=BatchStatus.QUEUED.value if number == 1 else BatchStatus.PENDING.value,
   442	            evidence_versions=[
   443	                {"evidence_id": row.highlight_id, "fingerprint": version_by_id[row.highlight_id].fingerprint}
   444	                for row in batch.rows
   445	            ],
   446	            document_ids=batch.document_ids,
   447	            bundle_path=str(batch_dir),
   448	            evidence_count=len(batch.rows),
   449	            document_count=len(batch.document_ids),
   450	        )
   451	        session.add(model)
   452	        for row in batch.rows:
   453	            session.add(
   454	                OpinionEvidenceAssignment(
   455	                    evidence_id=row.highlight_id,
   456	                    fingerprint=version_by_id[row.highlight_id].fingerprint,
   457	                    disposition="cycle",
   458	                    cycle_id=cycle.id,
   459	                    batch_number=number,
   460	                )
   461	            )
   462	    cycle.document_count = len({version.row.document_id for version in versions})
   463	    cycle.evidence_count = len(versions)
   464	    cycle.batch_count = len(batches)
   465	    cycle.current_batch = 1 if batches else 0
   466	    session.commit()
   467	
   468	
   469	def complete_cycle_directory(settings: Settings, cycle_id: str) -> Path:
   470	    active = settings.runs_dir / "active" / cycle_id
   471	    completed = settings.runs_dir / "completed" / cycle_id
   472	    if completed.exists() and not active.exists():
   473	        return completed
   474	    completed.parent.mkdir(parents=True, exist_ok=True)
   475	    if completed.exists():
   476	        shutil.rmtree(completed)
   477	    active.rename(completed)
   478	    return completed
   479	
   480	
   481	def retry_stopped_cycle(session: Session, cycle_id: str) -> OpinionBatch:
   482	    cycle = session.get(OpinionCycle, cycle_id)
   483	    if cycle is None:
   484	        raise ValueError(f"cycle not found: {cycle_id}")
   485	    if cycle.status != CycleStatus.STOPPED.value:
   486	        raise ValueError(f"cycle {cycle_id} is not stopped")
   487	    batch = session.scalar(
   488	        select(OpinionBatch).where(
   489	            OpinionBatch.cycle_id == cycle_id,
   490	            OpinionBatch.batch_number == cycle.current_batch,
   491	        )
   492	    )
   493	    if batch is None or batch.status != BatchStatus.STOPPED.value:
   494	        raise ValueError("stopped cycle has no retryable batch")
   495	    active = session.scalar(select(OpinionRun).where(OpinionRun.status.in_(NON_TERMINAL_RUN_STATUSES)))
   496	    if active is not None:
   497	        raise ValueError(f"run {active.id} is still active")
   498	    batch.status = BatchStatus.QUEUED.value
   499	    cycle.status = CycleStatus.ACTIVE.value
   500	    cycle.failure_code = None
   501	    cycle.failure_summary = None
   502	    session.commit()
   503	    return batch
   504	
   505	
   506	async def retry_stopped_snapshot(
   507	    *,
   508	    session: Session,
   509	    settings: Settings,
   510	    cycle_id: str,
   511	    sync_corpus: Callable[[], Awaitable[object]],
   512	) -> CycleStartResult:
   513	    """Rebuild a reserved cycle whose sync or bundle creation stopped before batch one."""
   514	    cycle = session.get(OpinionCycle, cycle_id)
   515	    if cycle is None:
   516	        raise ValueError(f"cycle not found: {cycle_id}")
   517	    if cycle.status != CycleStatus.STOPPED.value or cycle.failure_code != "snapshot_failed":
   518	        raise ValueError(f"cycle {cycle_id} has no failed snapshot")
   519	    if session.scalar(select(OpinionBatch).where(OpinionBatch.cycle_id == cycle_id)) is not None:
   520	        raise ValueError("cycle already has a retryable batch")
   521	    owner = uuid4().hex
   522	    now = datetime.now(UTC)
   523	    if not acquire_lease(session, "opinion-cycle-start", owner_token=owner, now=now):
   524	        raise RuntimeError("another cycle start owns the start lease")
   525	    try:
   526	        cycle.status = CycleStatus.STARTING.value
   527	        cycle.failure_code = None
   528	        cycle.failure_summary = None
   529	        session.commit()
   530	        await sync_corpus()
   531	        versions = _eligible_versions(session, settings, cycle)
   532	        batches = partition_evidence([version.row for version in versions])
   533	        _materialize_cycle(session, settings, cycle, versions, batches)
   534	        cycle.status = CycleStatus.ACTIVE.value if batches else CycleStatus.COMPLETED.value
   535	        session.commit()
   536	        if not batches:
   537	            complete_cycle_directory(settings, cycle.id)
   538	        return CycleStartResult(
   539	            cycle_id=cycle.id,
   540	            status=cycle.status,
   541	            batch_count=cycle.batch_count,
   542	            result_code="retried" if batches else "no_evidence",
   543	            created=False,
   544	        )
   545	    except Exception:
   546	        session.rollback()
   547	        cycle = session.get(OpinionCycle, cycle_id)
   548	        if cycle is not None:
   549	            cycle.status = CycleStatus.STOPPED.value
   550	            cycle.failure_code = "snapshot_failed"
   551	            cycle.failure_summary = "The weekly evidence snapshot failed. Retry the stopped cycle."
   552	            session.commit()
   553	        raise
   554	    finally:
   555	        release_lease(session, "opinion-cycle-start", owner)

