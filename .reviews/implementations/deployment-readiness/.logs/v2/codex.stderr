   500	def _write_initial_telegram_review(run_dir: Path, output: AgentTurnOutput) -> None:
   501	    lines = ["# Initial Telegram Messages", ""]
   502	    if not output.telegram_messages:
   503	        lines.append("(No Telegram messages.)")
   504	    for index, message in enumerate(output.telegram_messages, start=1):
   505	        if index > 1:
   506	            lines.extend(["", "---", ""])
   507	        lines.extend([f"## Message {index}", "", message.text])
   508	        if message.buttons:
   509	            lines.extend(["", "Buttons: " + ", ".join(button.text for button in message.buttons)])
   510	        if message.force_reply:
   511	            lines.extend(["", "Force reply: yes"])
   512	        if message.reply_to_message_id is not None:
   513	            lines.extend(["", f"Reply to message: {message.reply_to_message_id}"])
   514	    write_text_atomic(run_dir / "review" / "initial-telegram.md", "\n".join(lines).rstrip() + "\n")
